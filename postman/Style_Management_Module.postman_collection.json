              "raw": "{\n  \"style_id\": 1,\n  \"sample_no\": \"SMP-POSTMAN-01\",\n  \"effective_date\": \"2025-03-01\",\n  \"prepared_by\": \"Tech Designer\",\n  \"remarks\": \"Initial technical specification release.\",\n  \"dimensions\": [\n    {\n      \"dimension_type\": \"Body Height\",\n      \"specification\": \"Base to top opening\",\n      \"value\": 30,\n      \"tolerance_minus\": 0.5,\n      \"tolerance_plus\": 0.5,\n      \"uom\": \"cm\",\n      \"remarks\": \"Measure center\"\n    },\n    {\n      \"dimension_type\": \"Body Width\",\n      \"specification\": \"Base seam to seam\",\n      \"value\": 38,\n      \"tolerance_minus\": 0.5,\n      \"tolerance_plus\": 0.5,\n      \"uom\": \"cm\",\n      \"remarks\": \"Flat measurement\"\n    }\n  ],\n  \"materials\": [\n    {\n      \"line_no\": 1,\n      \"item_id\": 1,\n      \"material_name\": \"Leather Sheet - Napa\",\n      \"material_type\": \"Main Leather\",\n      \"consumption\": 14.5,\n      \"uom\": \"SQFT\",\n      \"wastage_percent\": 10\n    }\n  ],\n  \"components\": [\n    {\n      \"line_no\": 1,\n      \"item_id\": 3,\n      \"component_name\": \"Metal Zipper #5\",\n      \"component_type\": \"Hardware\",\n      \"color\": \"Antique Brass\",\n      \"size\": \"38 cm\",\n      \"qty\": 1,\n      \"uom\": \"PCS\"\n    }\n  ],\n  \"construction\": {\n    \"construction_method\": \"Turned Edge Stitched\",\n    \"stitch_type\": \"Lockstitch 301\",\n    \"spi\": \"7-8 SPI\",\n    \"thread_type\": \"Continuous Filament Bonded\",\n    \"seam_allowance\": \"8 mm\",\n    \"edge_treatment\": \"3 coats edge paint with intermediate sanding\",\n    \"special_notes\": \"Clean symmetrical alignment required.\"\n  },\n  \"colors\": [\n    {\n      \"color_name\": \"Cognac Tan\",\n      \"pantone\": \"18-1140 TCX\",\n      \"main_material_color\": \"Napa Tan\",\n      \"lining_color\": \"Sand Beige Twill\",\n      \"hardware_color\": \"Antique Brass\"\n    }\n  ],\n  \"operations\": [\n    {\n      \"sequence\": 1,\n      \"operation_code\": \"OP-01\",\n      \"operation_name\": \"Leather Cutting\",\n      \"work_center\": \"Cutting\",\n      \"machine\": \"Clicker Press\",\n      \"smv\": 4.5,\n      \"skill_level\": \"Skilled\"\n    },\n    {\n      \"sequence\": 2,\n      \"operation_code\": \"OP-02\",\n      \"operation_name\": \"Main Stitching\",\n      \"work_center\": \"Stitching\",\n      \"machine\": \"Post Bed\",\n      \"smv\": 12,\n      \"skill_level\": \"Master Artisan\"\n    }\n  ],\n  \"quality\": [\n    {\n      \"inspection_point\": \"Dimensions Check\",\n      \"standard\": \"AQL 1.5\",\n      \"tolerance\": \"+/- 5mm\",\n      \"inspection_method\": \"Steel Ruler\",\n      \"critical\": \"Yes\"\n    }\n  ],\n  \"packaging\": {\n    \"polybag_size\": \"500 x 600 mm\",\n    \"dust_bag\": \"100% Non-woven 90 GSM\",\n    \"carton_qty\": 10,\n    \"packing_instruction\": \"Tissue stuffing inside to retain shape.\"\n  }\n}"
