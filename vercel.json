{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "functions": {
    "index.js": {
      "includeFiles": "{backend/**,frontend/build/**}"
    },
    "app.js": {
      "includeFiles": "{backend/**,frontend/build/**}"
    }
  }
}
